# Copy to .env.server.local and fill these values locally. Never use REACT_APP_ for secrets.
API_PORT=3002
API_HOST=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# A sender address approved by your SMTP service:
SMTP_FROM=
ENQUIRY_TO=ammananafoodschennai@gmail.com
# Local SMTP testing only. Keep false for real email delivery.
SMTP_ALLOW_PLAINTEXT=false
# Set only when deploying behind a known reverse proxy.
TRUST_PROXY_HOPS=0

{
  "name": "amma-nana-foods",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "nodemailer": "^10.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "concurrently -k -n api,web \"npm:server\" \"npm:client\"",
    "client": "react-scripts start",
    "server": "node --env-file-if-exists=.env.server.local server/index.cjs",
    "test:server": "node --test server/*.test.cjs",
    "serve": "node --env-file-if-exists=.env.server.local server/index.cjs",
    "build": "react-scripts build && node scripts/prerender.cjs",
    "test:seo": "node --test scripts/seo.test.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "concurrently": "^10.0.6",
    "http-proxy-middleware": "^2.0.10",
    "smtp-server": "^3.20.2"
  }
}
